<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TraeTools.Views.LoginWindow" Width="540"
        Background="White"
        FontFamily="Microsoft YaHei UI,Segoe UI">
    <!-- 与仓库根 Views/LoginWindow.axaml 的区别：
         1) 根元素改为 UserControl（单视图平台不能 new Window()）；
         2) 桌面端「自动登录（内嵌浏览器）」依赖 TraeTools.LoginHost.exe（WinForms + WebView2），
            Android 上不存在对应实现，改为「获取步骤」引导 + 手动粘贴凭证。
         粘贴逻辑（TokenUtils 校验、写入账号、Save）与桌面端完全一致。 -->
    <Grid RowDefinitions="Auto,*,Auto" Background="White">
        <Border Grid.Row="0" Background="#FFF9FAFB" BorderBrush="#FFE2E8F0" BorderThickness="0,0,0,1" Padding="16,14">
            <TextBlock Text="登录 TRAE 账号" FontSize="15" FontWeight="Bold" Foreground="#FF0F172A" />
        </Border>

        <Border Grid.Row="1" Padding="16,14"><ScrollViewer><StackPanel Spacing="12">
            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#FF0F172A" LineHeight="20">
手机端无法内嵌浏览器自动截取凭证，请按下述步骤手动获取 Cloud-IDE-Token。
            </TextBlock>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="查看获取步骤" Click="OnAutoLoginClick" Classes="btn-primary"
                        HorizontalAlignment="Left" MinWidth="160" Height="40" Padding="16,0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                <Button Content="打开 trae.cn" Click="OnOpenBrowserClick" Classes="btn"
                        HorizontalAlignment="Left" MinWidth="130" Height="40" Padding="16,0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="AutoStatus" FontSize="12" Foreground="#FF92400E" TextWrapping="Wrap" LineHeight="19" />

            <Border Height="1" Background="#FFE2E8F0" Margin="0,6" />

            <TextBlock Text="在电脑浏览器登录 www.trae.cn 后，F12 → Application → Local Storage 复制 Cloud-IDE-Token 的值，粘贴到下方保存（粘贴一次即可长期使用）。"
                       TextWrapping="Wrap" FontSize="12" Foreground="#FF64748B" LineHeight="19" />

            <TextBlock Text="Cloud-IDE-Token" FontSize="11" Foreground="#FF94A3B8" />
            <TextBox x:Name="TokenBox" Height="110" AcceptsReturn="True"
                     PlaceholderText="粘贴 Cloud-IDE-Token…" FontFamily="Consolas" FontSize="11"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />

            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#FF92400E" TextWrapping="Wrap" />
        </StackPanel></ScrollViewer></Border>

        <Border Grid.Row="2" Background="#FFF9FAFB" BorderBrush="#FFE2E8F0" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <Button Content="取消" MinWidth="100" Height="36" Padding="12,0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnCancelClick" />
                <Button Content="保存" MinWidth="100" Height="36" Padding="12,0" Classes="btn-primary"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSaveClick" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
