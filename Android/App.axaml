<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TraeTools.App"
             xmlns:local="using:TraeTools"
             RequestedThemeVariant="Light">

    <!-- Android 版 Application。
         与仓库根的 App.axaml 内容一致，仅入口与生命周期不同：
         Android 走 ISingleViewApplicationLifetime，没有 MainWindow。
         主题固定 Light：Styles/AppTheme.axaml 的颜色是写死的浅色调色板，
         跟随系统深色会出现浅底白字的不可读组合。 -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://TraeTools/Styles/AppTheme.axaml" />
    </Application.Styles>
</Application>
