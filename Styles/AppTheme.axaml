<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      ============================ 主题令牌 ============================
      只有这一份配色表：同一批语义色按 Light / Dark 两套取值定义在 ThemeDictionaries 里。
      切换 Application.RequestedThemeVariant 即全局生效，不存在「第二套配色文件」。

      · Light 的取值与改造前**逐字节一致**，因此既有页面在浅色下外观零变化。
      · 组件样式与各页面统一用 DynamicResource 引用：
        StaticResource 只在解析时查一次，主题切换后不会刷新（这正是必须改的原因）。
      · 新增令牌（AccentHover / RowBg / StatusWarn* / Code* / *Tint / 渐变等）
        供本次新增的页面使用，不影响既有页面。
    -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <!-- ================= 浅色：全部沿用改造前的取值 ================= -->
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SidebarBg">#FF1E293B</Color>
                    <Color x:Key="Accent">#FF3B82F6</Color>
                    <Color x:Key="AccentHover">#FF5B95F8</Color>
                    <Color x:Key="AccentDeep">#FF2A6BD4</Color>
                    <Color x:Key="AccentSoft">#1A3B82F6</Color>
                    <Color x:Key="Violet">#FF8B5CF6</Color>
                    <Color x:Key="ContentBg">#FFF1F5F9</Color>
                    <Color x:Key="CardBg">#FFFFFFFF</Color>
                    <Color x:Key="RowBg">#FFF9FAFB</Color>
                    <Color x:Key="HeroTintBg">#FFE8F1FE</Color>
                    <Color x:Key="HeroTintSub">#FF64748B</Color>
                    <Color x:Key="RingTrack">#FFDBEAFE</Color>
                    <Color x:Key="TextMain">#FF0F172A</Color>
                    <Color x:Key="TextMuted">#FF64748B</Color>
                    <Color x:Key="TextSub">#FF94A3B8</Color>
                    <Color x:Key="BorderColor">#FFE2E8F0</Color>
                    <Color x:Key="Success">#FF10B981</Color>
                    <Color x:Key="SuccessSoft">#1A10B981</Color>
                    <Color x:Key="Warning">#FFF59E0B</Color>
                    <Color x:Key="WarningSoft">#1AF59E0B</Color>
                    <Color x:Key="Danger">#FFEF4444</Color>
                    <Color x:Key="DangerSoft">#1AEF4444</Color>
                    <Color x:Key="StatusWarnBg">#FFFEF7E8</Color>
                    <Color x:Key="StatusWarnBorder">#FFF3D9A8</Color>
                    <Color x:Key="StatusWarnFg">#FF92400E</Color>
                    <!-- code-box 沿用改造前的深色底，故文字取浅色 -->
                    <Color x:Key="CodeBg">#FF0F172A</Color>
                    <Color x:Key="CodeText">#FFCBD5E1</Color>
                    <Color x:Key="HoverTint">#0F3B82F6</Color>
                    <Color x:Key="SelectedTint">#1F3B82F6</Color>
                    <Color x:Key="HeroDark">#FF1E293B</Color>
                    <Color x:Key="HeroDark2">#FF334155</Color>

                    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBg}" />
                    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}" />
                    <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeep}" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoft}" />
                    <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource Violet}" />
                    <SolidColorBrush x:Key="ContentBgBrush" Color="{StaticResource ContentBg}" />
                    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBg}" />
                    <SolidColorBrush x:Key="RowBgBrush" Color="{StaticResource RowBg}" />
                    <SolidColorBrush x:Key="HeroTintBgBrush" Color="{StaticResource HeroTintBg}" />
                    <SolidColorBrush x:Key="HeroTintSubBrush" Color="{StaticResource HeroTintSub}" />
                    <SolidColorBrush x:Key="RingTrackBrush" Color="{StaticResource RingTrack}" />
                    <SolidColorBrush x:Key="TextMainBrush" Color="{StaticResource TextMain}" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
                    <SolidColorBrush x:Key="TextSubBrush" Color="{StaticResource TextSub}" />
                    <SolidColorBrush x:Key="BorderBrushKey" Color="{StaticResource BorderColor}" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
                    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoft}" />
                    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
                    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoft}" />
                    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />
                    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoft}" />
                    <SolidColorBrush x:Key="StatusWarnBgBrush" Color="{StaticResource StatusWarnBg}" />
                    <SolidColorBrush x:Key="StatusWarnBorderBrush" Color="{StaticResource StatusWarnBorder}" />
                    <SolidColorBrush x:Key="StatusWarnFgBrush" Color="{StaticResource StatusWarnFg}" />
                    <SolidColorBrush x:Key="CodeBgBrush" Color="{StaticResource CodeBg}" />
                    <SolidColorBrush x:Key="CodeTextBrush" Color="{StaticResource CodeText}" />
                    <SolidColorBrush x:Key="HoverTintBrush" Color="{StaticResource HoverTint}" />
                    <SolidColorBrush x:Key="SelectedTintBrush" Color="{StaticResource SelectedTint}" />
                    <SolidColorBrush x:Key="WhiteBrush" Color="White" />
                    <SolidColorBrush x:Key="HeroDarkBrush" Color="{StaticResource HeroDark}" />
                    <SolidColorBrush x:Key="HeroDark2Brush" Color="{StaticResource HeroDark2}" />
                    <LinearGradientBrush x:Key="BrandHeroBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#FF2563EB" Offset="0" />
                        <GradientStop Color="#FF6D3DE8" Offset="0.55" />
                        <GradientStop Color="#FF8B5CF6" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="BrandButtonBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#FF2563EB" Offset="0" />
                        <GradientStop Color="#FF8B5CF6" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="ChartAreaBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#593B82F6" Offset="0" />
                        <GradientStop Color="#0A3B82F6" Offset="1" />
                    </LinearGradientBrush>
                </ResourceDictionary>

                <!-- ================= 深色 ================= -->
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SidebarBg">#FF0B1220</Color>
                    <Color x:Key="Accent">#FF60A5FA</Color>
                    <Color x:Key="AccentHover">#FF7CB8FF</Color>
                    <Color x:Key="AccentDeep">#FF3B82F6</Color>
                    <Color x:Key="AccentSoft">#3360A5FA</Color>
                    <Color x:Key="Violet">#FFB07CFF</Color>
                    <Color x:Key="ContentBg">#FF0F1420</Color>
                    <Color x:Key="CardBg">#FF181F30</Color>
                    <Color x:Key="RowBg">#FF1E2740</Color>
                    <Color x:Key="HeroTintBg">#FF1B2542</Color>
                    <Color x:Key="HeroTintSub">#FF93A6D4</Color>
                    <Color x:Key="RingTrack">#FF2C3A5E</Color>
                    <Color x:Key="TextMain">#FFEDF1FA</Color>
                    <Color x:Key="TextMuted">#FFA6B0C3</Color>
                    <Color x:Key="TextSub">#FF6D7994</Color>
                    <Color x:Key="BorderColor">#FF273046</Color>
                    <Color x:Key="Success">#FF4CC491</Color>
                    <Color x:Key="SuccessSoft">#264CC491</Color>
                    <Color x:Key="Warning">#FFF0A64B</Color>
                    <Color x:Key="WarningSoft">#26F0A64B</Color>
                    <Color x:Key="Danger">#FFFF7079</Color>
                    <Color x:Key="DangerSoft">#26FF7079</Color>
                    <Color x:Key="StatusWarnBg">#33E0A64B</Color>
                    <Color x:Key="StatusWarnBorder">#4DE0A64B</Color>
                    <Color x:Key="StatusWarnFg">#FFF0C36A</Color>
                    <Color x:Key="CodeBg">#FF0B101C</Color>
                    <Color x:Key="CodeText">#FF67E8F9</Color>
                    <Color x:Key="HoverTint">#2660A5FA</Color>
                    <Color x:Key="SelectedTint">#4060A5FA</Color>
                    <Color x:Key="HeroDark">#FF151B2A</Color>
                    <Color x:Key="HeroDark2">#FF232C44</Color>

                    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBg}" />
                    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}" />
                    <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeep}" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoft}" />
                    <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource Violet}" />
                    <SolidColorBrush x:Key="ContentBgBrush" Color="{StaticResource ContentBg}" />
                    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBg}" />
                    <SolidColorBrush x:Key="RowBgBrush" Color="{StaticResource RowBg}" />
                    <SolidColorBrush x:Key="HeroTintBgBrush" Color="{StaticResource HeroTintBg}" />
                    <SolidColorBrush x:Key="HeroTintSubBrush" Color="{StaticResource HeroTintSub}" />
                    <SolidColorBrush x:Key="RingTrackBrush" Color="{StaticResource RingTrack}" />
                    <SolidColorBrush x:Key="TextMainBrush" Color="{StaticResource TextMain}" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
                    <SolidColorBrush x:Key="TextSubBrush" Color="{StaticResource TextSub}" />
                    <SolidColorBrush x:Key="BorderBrushKey" Color="{StaticResource BorderColor}" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
                    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoft}" />
                    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
                    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoft}" />
                    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />
                    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoft}" />
                    <SolidColorBrush x:Key="StatusWarnBgBrush" Color="{StaticResource StatusWarnBg}" />
                    <SolidColorBrush x:Key="StatusWarnBorderBrush" Color="{StaticResource StatusWarnBorder}" />
                    <SolidColorBrush x:Key="StatusWarnFgBrush" Color="{StaticResource StatusWarnFg}" />
                    <SolidColorBrush x:Key="CodeBgBrush" Color="{StaticResource CodeBg}" />
                    <SolidColorBrush x:Key="CodeTextBrush" Color="{StaticResource CodeText}" />
                    <SolidColorBrush x:Key="HoverTintBrush" Color="{StaticResource HoverTint}" />
                    <SolidColorBrush x:Key="SelectedTintBrush" Color="{StaticResource SelectedTint}" />
                    <SolidColorBrush x:Key="WhiteBrush" Color="White" />
                    <SolidColorBrush x:Key="HeroDarkBrush" Color="{StaticResource HeroDark}" />
                    <SolidColorBrush x:Key="HeroDark2Brush" Color="{StaticResource HeroDark2}" />
                    <LinearGradientBrush x:Key="BrandHeroBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#FF3B54E8" Offset="0" />
                        <GradientStop Color="#FF7C4CE0" Offset="0.55" />
                        <GradientStop Color="#FFA855F7" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="BrandButtonBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#FF3B54E8" Offset="0" />
                        <GradientStop Color="#FFA855F7" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="ChartAreaBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#5960A5FA" Offset="0" />
                        <GradientStop Color="#0A60A5FA" Offset="1" />
                    </LinearGradientBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ========== Card Style ========== -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="22" />
    </Style>

    <!-- ========== Panel Style ========== -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <!-- ========== Primary Button Style ========== -->
    <Style Selector="Button.btn-primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ========== Danger Button Style（需重登/警示操作） ========== -->
    <Style Selector="Button.btn-danger">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ========== Default Button Style ========== -->
    <Style Selector="Button.btn">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ========== Ghost Button Style ========== -->
    <Style Selector="Button.btn-ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ========== Badge Styles ========== -->
    <Style Selector="Border.badge-ok">
        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,3" />
    </Style>
    <Style Selector="Border.badge-warn">
        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,3" />
    </Style>
    <Style Selector="Border.badge-info">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,3" />
    </Style>
    <Style Selector="Border.badge-danger">
        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,3" />
    </Style>

    <!-- ========== Navigation Item ========== -->
    <Style Selector="Button.nav-item">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSubBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Button.nav-item:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#22FFFFFF" />
        <Setter Property="TextElement.Foreground" Value="White" />
    </Style>
    <Style Selector="Button.nav-item-active">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <!-- ========== Page Title ========== -->
    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}" />
    </Style>
    <Style Selector="TextBlock.page-subtitle">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.card-title">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.card-value">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}" />
    </Style>

    <!-- 空列表/空状态说明文案（新增页面复用） -->
    <Style Selector="TextBlock.empty-desc">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSubBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ========== Code Box ========== -->
    <Style Selector="Border.code-box">
        <Setter Property="Background" Value="{DynamicResource CodeBgBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <!-- ========== Default Window Font ========== -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="Inter,Microsoft YaHei UI,Segoe UI" />
    </Style>

</Styles>
